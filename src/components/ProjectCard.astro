---
import StatusBadge from "./StatusBadge.astro";

export interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      status: string;
      startDate: Date;
      endDate?: Date;
      tags: string[];
      techStack: string[];
      repoUrl?: string;
      demoUrl?: string;
      featured?: boolean;
    };
  };
  logCount: number;
  latestLogDate: Date;
}

const { project, logCount, latestLogDate } = Astro.props;
const formattedLatestDate = new Date(latestLogDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article
  class="project-card border border-border rounded-lg p-5 hover:border-accent transition-all bg-background shadow-sm flex flex-col justify-between"
  data-status={project.data.status}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
      <h3 class="text-xl font-bold tracking-tight">
        <a
          href={`/projects/${project.id}`}
          class="hover:text-accent transition-colors underline-offset-4 hover:underline text-foreground"
        >
          {project.data.title}
        </a>
      </h3>
      <StatusBadge status={project.data.status} />
    </div>

    <p class="text-foreground/80 text-sm mb-4 line-clamp-2">
      {project.data.description}
    </p>
  </div>

  <div>
    <div class="flex items-center justify-between text-xs font-mono text-foreground/60 pt-3 border-t border-border">
      <span>{logCount} {logCount === 1 ? "log entry" : "log entries"}</span>
      <span>Updated: {formattedLatestDate}</span>
    </div>
  </div>
</article>
