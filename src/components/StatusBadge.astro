---
export interface Props {
  status: string;
  className?: string;
}

const { status, className = "" } = Astro.props;

const statusStyles: Record<string, string> = {
  active: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30",
  planning: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30",
  exploring: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/30",
  maintaining: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/30",
  paused: "bg-zinc-500/10 text-zinc-600 dark:text-zinc-400 border-zinc-500/30",
  completed: "bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/30",
};

const currentStyle = statusStyles[status.toLowerCase()] || "bg-skin-fill text-skin-base border-skin-line";
---

<span
  class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-mono border font-medium uppercase tracking-wider ${currentStyle} ${className}`}
>
  ● {status}
</span>
