---
export interface Props {
  type: "project" | "skill";
  log: {
    id: string;
    data: {
      title: string;
      date: Date;
      tags: string[];
    };
  };
  parentTitle: string;
  parentSlug: string;
  logSlug?: string;
  Content?: any;
  excerpt?: string;
  showParentLink?: boolean;
}

const {
  type,
  log,
  parentTitle,
  parentSlug,
  logSlug: customLogSlug,
  Content,
  excerpt,
  showParentLink = true,
} = Astro.props;

const logSlug = customLogSlug || (log.id.includes("/") ? log.id.split("/").pop()! : log.id);

const formattedDate = new Date(log.data.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const typeBadgeStyle =
  type === "project"
    ? "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/30"
    : "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/30";

const parentHref = type === "project" ? `/projects/${parentSlug}` : `/learning/${parentSlug}`;
const logDetailHref = `${parentHref}/${logSlug}`;
---

<article class="log-entry border-l-2 border-accent/60 px-4 py-4 my-4 bg-muted/30 rounded-r-lg overflow-hidden">
  <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
    <div class="flex items-center gap-2 flex-wrap min-w-0">
      <span class={`inline-block px-2 py-0.5 text-xs font-mono border rounded uppercase font-semibold tracking-wider shrink-0 ${typeBadgeStyle}`}>
        {type === "project" ? "Project" : "Learning"}
      </span>

      {showParentLink && (
        <a
          href={parentHref}
          class="text-xs font-mono text-accent hover:underline font-medium truncate"
        >
          {parentTitle}
        </a>
      )}
    </div>

    <time datetime={new Date(log.data.date).toISOString()} class="text-xs font-mono text-foreground/60 shrink-0 ml-auto">
      {formattedDate}
    </time>
  </div>

  <h4 class="text-lg font-bold text-foreground tracking-tight mb-2">
    <a href={logDetailHref} class="hover:text-accent transition-colors hover:underline">
      {log.data.title}
    </a>
  </h4>

  {Content ? (
    <div>
      <div class="prose dark:prose-invert max-w-none text-sm text-foreground/90 mb-3">
        <Content />
      </div>
      <a
        href={logDetailHref}
        class="inline-flex items-center gap-1 text-xs font-mono text-accent hover:underline font-semibold bg-background p-1.5 px-2.5 rounded border border-border hover:border-accent transition-colors"
      >
        <span>Open full log page & outline →</span>
      </a>
    </div>
  ) : excerpt ? (
    <div>
      <p class="text-sm text-foreground/80 line-clamp-2 italic mb-2">
        "{excerpt}"
      </p>
      <a
        href={logDetailHref}
        class="inline-block text-xs font-mono text-accent hover:underline font-semibold"
      >
        Read full log entry →
      </a>
    </div>
  ) : null}
</article>
